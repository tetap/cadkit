{
  "name": "@cadkit/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "benchmark": "vite --open /#/benchmark"
  },
  "dependencies": {
    "@cadkit/assets": "workspace:*",
    "@cadkit/document": "workspace:*",
    "@cadkit/editor": "workspace:*",
    "@cadkit/geometry": "workspace:*",
    "@cadkit/guides": "workspace:*",
    "@cadkit/io-dxf": "workspace:*",
    "@cadkit/io-gcode": "workspace:*",
    "@cadkit/io-svg": "workspace:*",
    "@cadkit/render-webgpu": "workspace:*",
    "@cadkit/scene": "workspace:*",
    "@cadkit/text": "workspace:*",
    "@cadkit/types": "workspace:*",
    "@cadkit/worker-runtime": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "happy-dom": "^20.11.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  }
}
