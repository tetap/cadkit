{
  "name": "@cadkit/render-webgpu",
  "version": "0.1.0",
  "description": "WebGPU backend with instancing, picking and buffer paging",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@cadkit/assets": "workspace:*",
    "@cadkit/render-core": "workspace:*",
    "@cadkit/scene": "workspace:*",
    "@cadkit/types": "workspace:*",
    "earcut": "^3.2.3"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@webgpu/types": "^0.1.61",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
