{
  "name": "@cadkit/io-svg",
  "version": "0.1.0",
  "description": "SVG import/export with svg-pathdata path expansion",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@cadkit/types": "workspace:*",
    "@cadkit/geometry": "workspace:*",
    "svg-pathdata": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "rimraf": "^6.0.1"
  }
}
